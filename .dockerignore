# Keeps the build context small and — most importantly — keeps secrets out of it: nothing
# excluded here is needed by the Dockerfile's build stage (see its own comments) or the
# runtime stage's COPY --from list.

# Build outputs — regenerated by the build stage itself
build/
.gradle/
**/build/

# VCS and editor metadata
.git/
.gitignore
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
bin/
out/

# CodeGraph index — per-worktree dev tooling, never needed to build or run the jar
.codegraph/

# jqwik property-test seed database — local run cache, never needed to build or run the jar
.jqwik-database

# Teacher PDFs (ingestion input, git-ignored, never read by the running server)
data/pdfs/
# Manual-review aid regenerated during ingestion (backend/AGENTS.md), not read by the server
data/corpus-review.md

# Secrets — must never enter the build context or the image (workspace AGENTS.md "Nunca")
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db

# Logs
*.log
hs_err_pid*
