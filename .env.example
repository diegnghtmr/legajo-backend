# Legajo backend environment (TRD §8, §14.1, §14.4). Copy to `.env` for local use.
# Never commit real values; production values live in the Render service settings.

# --- Server ---
# Embedding mode for `embedding-api`: `cached` (default, never touches the network)
# or `live` (fetches vectors at request time; needs the four variables below).
LEGAJO_EMBEDDING_PROVIDER=cached

# Comma-separated list of allowed CORS origins (TRD §14.4). Empty keeps the defaults
# http://localhost:5173 (Vite dev) and http://localhost (Compose); a defined list
# replaces them. On Render, set it to the public Vercel origin.
LEGAJO_CORS_ORIGINS=

# --- Live mode of embedding-api and cache regeneration (ADR-015) ---
# Gemini API key. Required only for `live` mode or for regenerating the cache.
SPRING_AI_OPENAI_API_KEY=
# Gemini's OpenAI-compatible layer; the SDK always POSTs to {base-url}/embeddings.
SPRING_AI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LEGAJO_EMBEDDING_API_MODEL=gemini-embedding-2-preview
LEGAJO_EMBEDDING_API_DIMENSION=1536

# --- Ingest profile ---
# GROBID endpoint used by the ingest CLI (order: --grobid-url, then this variable,
# then http://localhost:8070).
LEGAJO_GROBID_URL=http://localhost:8070
