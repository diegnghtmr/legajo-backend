# Legajo backend environment. Copy to `.env` for local use; never commit `.env`.
# In production, set these values in the hosting provider's environment panel.

# --- Server ---

# Embedding source: `cached` (default) reads data/embeddings-*.json and needs no
# network; `live` calls the embedding API configured below at request time.
LEGAJO_EMBEDDING_PROVIDER=cached

# Comma-separated list of browser origins allowed by CORS for /api/v1/**.
# Empty keeps the defaults (http://localhost:5173 and http://localhost); a
# defined list replaces them. In production, set the frontend's public origin.
LEGAJO_CORS_ORIGINS=

# --- Embedding API: live mode and cache regeneration ---
# Read by the server when LEGAJO_EMBEDDING_PROVIDER=live, and required by
# `:bootstrap:precomputeApiEmbeddings`.

# Secret. Read from the environment only; never logged.
SPRING_AI_OPENAI_API_KEY=
# OpenAI-compatible embeddings endpoint (Gemini).
SPRING_AI_OPENAI_BASE_URL=
# Embedding model name (the server defaults to gemini-embedding-2-preview).
LEGAJO_EMBEDDING_API_MODEL=gemini-embedding-2-preview
# Vector dimension, a positive integer (the server defaults to 1536).
LEGAJO_EMBEDDING_API_DIMENSION=1536

# --- Corpus ingestion (`:bootstrap:ingest`) ---

# GROBID endpoint. Resolves as --grobid-url, then this variable, then
# http://localhost:8070; a blank value counts as unset.
LEGAJO_GROBID_URL=

# --- Full-stack Compose (docker-compose.yml) ---

# Frontend checkout that Compose builds (default ../frontend).
LEGAJO_FRONTEND_DIR=../frontend
# Backend URL baked into the frontend build (default http://localhost:8080).
VITE_API_BASE_URL=http://localhost:8080
# Host port that publishes the frontend (default 80).
LEGAJO_FRONTEND_PORT=80
