# Rename this file to .env.example (tracked in git, values always empty).
# Copy it to .env for local runs and fill in the values there; .env is git-ignored.

# Embedding provider used at runtime: "cached" reads data/embeddings-*.json and needs no network.
LEGAJO_EMBEDDING_PROVIDER=cached

# Comma-separated list of browser origins allowed by CORS (TRD §14.4).
LEGAJO_CORS_ORIGINS=

# OpenAI-compatible embeddings endpoint, used only to regenerate the embedding-api cache.
SPRING_AI_OPENAI_BASE_URL=
SPRING_AI_OPENAI_API_KEY=

# GROBID REST endpoint, used only by the one-off ingestion job (compose profile "ingest").
LEGAJO_GROBID_URL=http://localhost:8070
